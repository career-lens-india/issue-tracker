# Backend
PORT=5000
NODE_ENV=development

# Database mode: dev (in-memory, default for local dev) | student | production | test
# APP_MODE=dev
# External MongoDB — required when APP_MODE=student or APP_MODE=production
# MONGODB_URI=mongodb://127.0.0.1:27017/sprintboard

# Optional: dedicated database for automated tests (defaults to in-memory if unset during tests)
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/sprintboard_test

# Frontend (Vite) — API base URL; leave empty to use dev proxy to http://localhost:5000
# VITE_API_URL=

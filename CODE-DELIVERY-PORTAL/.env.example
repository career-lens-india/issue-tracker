# Server
PORT=4000
NODE_ENV=development

# Database mode: dev (in-memory, default for local dev) | student | production | test
# APP_MODE=dev
# External MongoDB — required when APP_MODE=student or APP_MODE=production
# MONGODB_URI=mongodb://127.0.0.1:27017/sprintboard_portal

# Student materials (optional). Auto-resolved in order:
# 1) this path (relative to CODE-DELIVERY-PORTAL/ or absolute)
# 2) server/student-materials/ (after npm run sync:materials — used on Vercel)
# 3) ../APPLICATION/student-materials (monorepo — same tree as SprintBoard app)
# STUDENT_MATERIALS_PATH=../APPLICATION/student-materials

# Admin (change before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Workshop gate — share with students during class; change after the session
STUDENT_ACCESS_PASSWORD=change-me-for-each-session

# Session — use a long random string in production (32+ chars)
SESSION_SECRET=replace-with-cryptographically-random-secret

# Vite dev server origin (must match browser URL for session cookies)
CLIENT_ORIGIN=http://localhost:5173

# Optional: comma-separated extra frontend origins (Vercel preview URLs)
# ALLOWED_ORIGINS=https://code-delivery-platform-xxx.vercel.app,https://code-delivery-platform.vercel.app

# Vercel: set to your deployed frontend origin, e.g. https://your-portal.vercel.app
# VITE_API_URL=https://your-portal-api.vercel.app

# Client dev proxy targets API on PORT
VITE_API_URL=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm run sync:materials",
  "functions": {
    "api/index.js": {
      "includeFiles": "student-materials/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
